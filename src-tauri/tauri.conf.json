{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirPop",
  "version": "1.2.0",
  "identifier": "dev.ignacio.airpop",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popup",
        "title": "AirPop Overlay",
        "url": "index.html#popup",
        "width": 420,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "resizable": false
      },
      {
        "label": "flyout",
        "title": "AirPop Flyout",
        "url": "index.html#flyout",
        "width": 380,
        "height": 490,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "setup",
        "title": "AirPop Setup",
        "url": "index.html#setup",
        "width": 540,
        "height": 660,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "resources/nsis-header.bmp",
        "sidebarImage": "resources/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
